PORT=3000
DATA_DIR=./data
DATABASE_URL=
# embedded (one process, supports PGlite) or external (shared PostgreSQL required)
INDEXER_MODE=embedded
INDEXER_CONCURRENCY=2
# Optional override: comma-separated HTTP RPC endpoints on chain 5042
RPC_HTTP=https://rpc.mainnet.arc.io,https://rpc.arc-scan.org,https://5042.rpc.thirdweb.com,https://arc-mainnet.infura.io/v3/b6bf7d3508c941499b10025c0776eaf8
# Optional first-party pools.trade Arc feed. Leave empty to use the strict
# poolstrade-labelled discovery mirror and pools.trade's Arc OHLC API.
POOLS_TRADE_ARC_API=
# History windows of 10,000 blocks each that one on-chain pass reaches back. 0 follows the head only.
ONCHAIN_BACKFILL=3
# Trade tape housekeeping. Off by default: when on, each day of a token's trading is summarised into one
# row and the raw trades behind it are removed, keeping the most recent per token regardless of age.
RETENTION_ENABLED=false
RETENTION_KEEP_PER_TOKEN=500
RETENTION_KEEP_HOURS=720
# Optional Etherscan-compatible Arc account API for paginated wallet holdings.
WALLET_EXPLORER_API=https://api.arc-scan.org/api
